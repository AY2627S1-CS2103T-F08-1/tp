@startuml
!pragma layout smetana
!include style.puml
skinparam classBackgroundColor MODEL_COLOR
skinparam classAttributeFontColor #FFFFFF
show members
title OSPS debtor data and persistent IDs

class AddressBook {
  - nextDebtorId : int
  + addPerson(person) : Person
  + setPerson(target, editedPerson)
  + removePerson(person)
}
class UniquePersonList
class Person {
  - debtorId : int
  + isSamePerson(other) : boolean
}
class Name
class Phone
class Email
class Address
class Tag
class OutstandingAmount {
  - value : BigDecimal
}
class InteractionNote {
  - timestamp : LocalDateTime
  - text : String
}
AddressBook *--> "1" UniquePersonList
UniquePersonList --> "0..*" Person
Person *--> "1" Name
Person *--> "1" Phone
Person *--> "1" Email
Person *--> "1" Address
Person *--> "0..*" Tag
Person *--> "1" OutstandingAmount
Person *--> "0..* {ordered}" InteractionNote
note bottom of AddressBook
  nextDebtorId is saved with the records.
  Deletion does not reset it; clear does.
end note
note bottom of Person
  Edit creates a replacement Person preserving
  its ID, amount and interaction history.
end note
@enduml
