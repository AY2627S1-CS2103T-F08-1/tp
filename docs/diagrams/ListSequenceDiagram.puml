@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam ParticipantPadding 10
title Listing all debtors

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant "l:ListCommand" as ListCommand LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:ModelManager" as LiveModel MODEL_COLOR
participant "c:ModelManager\n(candidate copy)" as ModelManager MODEL_COLOR
participant "filteredPersons:\nFilteredList" as FilteredList MODEL_COLOR
participant "sortedPersons:\nSortedList" as SortedList MODEL_COLOR
end box

note over LiveModel, SortedList
sortedPersons wraps filteredPersons. list restores the show-all predicate
and PersonSort.DEFAULT_COMPARATOR (ascending persistent debtor ID).
LogicManager publishes the candidate view without saving debtor data.
end note

[-> LogicManager : execute("list")
activate LogicManager
note over LogicManager, ListCommand
The parser has already created l.
end note
LogicManager -> LiveModel : createTransactionCopy()
LiveModel --> LogicManager : c
LogicManager -> ListCommand : execute(c)
activate ListCommand
ListCommand -> ModelManager : updatePersonView(\nPREDICATE_SHOW_ALL_PERSONS,\nDEFAULT_COMPARATOR)
activate ModelManager
ModelManager -> FilteredList : setPredicate(\nPREDICATE_SHOW_ALL_PERSONS)
activate FilteredList
FilteredList -> SortedList : change notification
FilteredList --> ModelManager
deactivate FilteredList
ModelManager -> SortedList : setComparator(DEFAULT_COMPARATOR)
ModelManager --> ListCommand
deactivate ModelManager
ListCommand -> ModelManager : getFilteredPersonList()
activate ModelManager
ModelManager --> ListCommand : sortedPersons
deactivate ModelManager
ListCommand -> SortedList : size()
SortedList --> ListCommand : debtorCount
ListCommand --> LogicManager : result
deactivate ListCommand
LogicManager -> LiveModel : publishTransaction(c)
[<-- LogicManager
deactivate LogicManager
@enduml
