@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor LOGIC_COLOR_T4
skinparam classBackgroundColor LOGIC_COLOR

package Logic as LogicPackage {
Class "<<interface>>\nLogic" as LogicApi
Class LogicManager
}

package Model as ModelPackage {
Class "<<interface>>\nModel" as ModelApi
Class ModelManager
}

package Storage as StoragePackage {
Class "<<interface>>\nStorage" as StorageApi
Class StorageManager
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> LogicApi

LogicManager .up.|> LogicApi
ModelManager .up.|> ModelApi
StorageManager .up.|> StorageApi

LogicManager --> ModelApi
LogicManager --> StorageApi
@enduml
