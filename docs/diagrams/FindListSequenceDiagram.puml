@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant "f:FindCommand" as FindCommand LOGIC_COLOR
participant "l:ListCommand" as ListCommand LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:ModelManager" as ModelManager MODEL_COLOR
participant "filteredPersons:\nFilteredList" as FilteredList MODEL_COLOR
participant "p:NameContains\nKeywordsPredicate" as Predicate MODEL_COLOR
participant "sortedPersons:\nSortedList" as SortedList MODEL_COLOR
end box

note over ModelManager, SortedList
sortedPersons wraps filteredPersons. find and list reset the comparator to
PersonSort.DEFAULT_COMPARATOR (ascending persistent debtor ID), replacing any earlier sort.
LogicManager runs each command on a transaction copy; as these commands change no
debtor data, the copy is published without saving (m below stands for that copy).
end note

[-> LogicManager : execute("find Alice 91234567")
activate LogicManager
note over LogicManager, FindCommand
The parser has already created f
with predicate p.
end note
LogicManager -> FindCommand : execute(m)
activate FindCommand
FindCommand -> ModelManager : updatePersonView(p, DEFAULT_COMPARATOR)
activate ModelManager
ModelManager -> FilteredList : setPredicate(p)
activate FilteredList
loop for each debtor
    FilteredList -> Predicate : test(person)
    activate Predicate
    Predicate --> FilteredList : literal substring name match\n(case-insensitive) OR exact phone match
    deactivate Predicate
end
FilteredList -> SortedList : change notification
FilteredList --> ModelManager
deactivate FilteredList
ModelManager -> SortedList : setComparator(DEFAULT_COMPARATOR)
ModelManager --> FindCommand
deactivate ModelManager
FindCommand -> ModelManager : getFilteredPersonList()
activate ModelManager
ModelManager --> FindCommand : sortedPersons
deactivate ModelManager
FindCommand -> SortedList : size()
SortedList --> FindCommand : matchCount
FindCommand --> LogicManager : result
deactivate FindCommand
[<-- LogicManager
deactivate LogicManager

[-> LogicManager : execute("list")
activate LogicManager
note over LogicManager, ListCommand
The parser has already created l.
end note
LogicManager -> ListCommand : execute(m)
activate ListCommand
ListCommand -> ModelManager : updatePersonView(\nPREDICATE_SHOW_ALL_PERSONS,\nDEFAULT_COMPARATOR)
activate ModelManager
ModelManager -> FilteredList : setPredicate(\nPREDICATE_SHOW_ALL_PERSONS)
activate FilteredList
FilteredList -> SortedList : change notification
FilteredList --> ModelManager
deactivate FilteredList
ModelManager -> SortedList : setComparator(DEFAULT_COMPARATOR)
ModelManager --> ListCommand
deactivate ModelManager
ListCommand -> ModelManager : getFilteredPersonList()
activate ModelManager
ModelManager --> ListCommand : sortedPersons
deactivate ModelManager
ListCommand -> SortedList : size()
SortedList --> ListCommand : debtorCount
ListCommand --> LogicManager : result
deactivate ListCommand
[<-- LogicManager
deactivate LogicManager
@enduml
