<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Scene?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.VBox?>
<?import javafx.stage.Stage?>

<fx:root minHeight="420.0" minWidth="430.0" resizable="false" title="OSPS Help" type="javafx.stage.Stage" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <icons>
    <Image url="@/images/help_icon.png" />
  </icons>
  <scene>
    <Scene height="540.0" width="600.0">
      <stylesheets>
        <URL value="@HelpWindow.css" />
      </stylesheets>

      <VBox fx:id="helpMessageContainer">
        <children>
          <Label fx:id="helpMessage" wrapText="true" />
          <Button fx:id="copyButton" mnemonicParsing="false" onAction="#copyUrl" text="Copy User Guide URL" />
          <ScrollPane fx:id="commandReferenceScroll" fitToWidth="true" focusTraversable="true"
                      prefHeight="420.0" VBox.vgrow="ALWAYS">
            <content>
              <Label fx:id="commandReference" wrapText="true" />
            </content>
          </ScrollPane>
        </children>
        <padding>
          <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
        </padding>
        <spacing>8.0</spacing>
      </VBox>
    </Scene>
  </scene>
</fx:root>
